@model Models.Media
@{
    var owner = DAL.DB.Users.Get(Model.OwnerId);
    string ownerAvatar = owner != null && !string.IsNullOrEmpty(owner.Avatar) ? owner.Avatar : "/App_Assets/Users/no_avatar.png";
    string ownerName = owner != null ? owner.Name : "Inconnu";
}

<div class="detailsPanel">
    <dl>
        <dd>
            <div class="mediaSharedBadge">
                @if (Model.Shared)
                {
                    <span class="badge media-shared">[Partagée]</span>
                }
            </div>
            @Model.Title
        </dd>
        <dd>
            @Helper.YoutubePlayer(Model.YoutubeId)
        </dd>
        <dd class="description">
            @Model.Description
        </dd>
        <dt>
            Catégorie
        </dt>

        <dd>
            @Model.Category
        </dd>

        <dt>
            Date de publication
        </dt>

        <dd>
            @Helper.When(Model.PublishDate)
        </dd>
        <dt>
            Publié par
        </dt>
        <dd>
            <div class="mediaOwner">
                <img class="mediaOwnerAvatar" src="@Url.Content(ownerAvatar)" alt="@ownerName" title="@ownerName" style="width:40px;height:40px;" />
                <div class="mediaOwnerInfo">
                    <div class="mediaOwnerName">@ownerName</div>
                </div>
            </div>
        </dd>

    </dl>
</div>
